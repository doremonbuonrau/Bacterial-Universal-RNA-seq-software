# Replace YOUR_LINUX_USERNAME with the output of: whoami
PROJECT_ID=txid_custom
REFERENCE_FA=/root/opdetect_input/genome.fasta
ANNOTATION_GFF=/root/opdetect_input/annotation.gff3
SAMPLES_TSV=/root/projects/opdetect_pipeline/samples.tsv

# Keep computational outputs in the WSL Linux filesystem for better performance.
OUTDIR=/root/opdetect_runs/txid_custom
OPDETECT_REPO=/root/tools/OpDetect

THREADS=8
ANNOTATION_FEATURE=CDS
HISAT2_EXTRA="--no-spliced-alignment"
PREDICTION_THRESHOLD=0.50
