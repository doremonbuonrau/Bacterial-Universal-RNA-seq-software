# A short identifier used for the OpDetect data folder and output names.
PROJECT_ID=txid_custom

# Absolute or relative input paths.
REFERENCE_FA=/path/to/genome.fasta
ANNOTATION_GFF=/path/to/annotation.gff3
SAMPLES_TSV=/path/to/samples.tsv

# Output/work directory.
OUTDIR=./opdetect_run

# OpDetect checkout. The pipeline clones the public repository here if absent.
OPDETECT_REPO=./OpDetect

THREADS=8

# GFF3 feature used as a gene. CDS is recommended for bacterial protein-coding operons.
ANNOTATION_FEATURE=CDS

# Additional HISAT2 options. Prokaryotic reads normally do not need spliced alignment.
HISAT2_EXTRA="--no-spliced-alignment"

# Probability threshold used to turn pair probabilities into binary edges and operon groups.
PREDICTION_THRESHOLD=0.50

# Minimum fraction of model-fold and balanced replicate-order predictions that
# must support an edge before it is used to build a robust candidate operon.
MIN_REPLICATE_SUPPORT=0.60

# auto: circular unless a FASTA header explicitly contains the word linear.
# Other choices are circular or linear for all sequence records.
REPLICON_TOPOLOGY=auto
